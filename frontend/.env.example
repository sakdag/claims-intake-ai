# After terraform apply, copy values from: terraform output frontend_env_hint
VITE_API_BASE=https://xxxxxxxxxx.execute-api.eu-north-1.amazonaws.com
VITE_COGNITO_REGION=eu-north-1
VITE_COGNITO_USER_POOL_ID=eu-north-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Leave Cognito vars unset to use local FastAPI without login (VITE_API_BASE=http://127.0.0.1:8000)
